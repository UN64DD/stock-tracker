# Server-side market data proxy configuration.
# Copy this file to server/.env and fill in your own values: `cp server/.env.example server/.env`
# server/.env is git-ignored and must never be committed.

# Twelve Data API key. Create a free key at https://twelvedata.com/pricing
# The key is only ever read by this server process and is never exposed to the browser.
STOCK_API_KEY=your_twelvedata_api_key_here

# Market data provider. Only "twelvedata" is currently supported.
STOCK_DATA_PROVIDER=twelvedata

# Finnhub API key, used only for the company/market news + sentiment feature.
# Create a free key at https://finnhub.io/register. Twelve Data has no general
# news endpoint, so news uses a separate provider. The free tier is licensed for
# personal/non-commercial use; review https://finnhub.io/terms before deploying.
# When this is missing the news endpoints return a clear "not configured" state
# and the rest of the app keeps working.
FINNHUB_API_KEY=your_finnhub_api_key_here

# News provider. Only "finnhub" is currently supported.
NEWS_DATA_PROVIDER=finnhub

# Port the proxy listens on. The Vite dev server proxies /api here.
PORT=3001

# Free-tier guard rails (Twelve Data Basic: 8 requests/minute, 800 credits/day).
PROVIDER_CREDITS_PER_MINUTE=8
PROVIDER_CREDITS_PER_DAY=800

# News provider guard rails (Finnhub free tier: 60 requests/minute).
NEWS_CREDITS_PER_MINUTE=60
NEWS_CREDITS_PER_DAY=1000

# Number of articles returned per news page (1–50).
NEWS_PAGE_SIZE=12

# Upstream request timeout in milliseconds.
REQUEST_TIMEOUT_MS=8000

# Origin allowed to call this proxy. In dev, the Vite server proxies requests so
# it is same-origin; keep the default unless you call the API from another origin.
CORS_ORIGIN=http://localhost:5173

# Cache TTLs, in seconds, per data type.
CACHE_TTL_QUOTE_SECONDS=60
CACHE_TTL_HISTORY_SECONDS=300
CACHE_TTL_SEARCH_SECONDS=300
CACHE_TTL_PROFILE_SECONDS=86400
CACHE_TTL_FINANCIALS_SECONDS=86400
CACHE_TTL_NEWS_SECONDS=600

# SQLite database file for users, sessions and watchlists. The parent directory
# is created automatically. This file is git-ignored and must not be committed.
DATABASE_PATH=./data/stock-tracker.sqlite

# Session lifetime in seconds (default 7 days) and the session cookie name.
SESSION_TTL_SECONDS=604800
AUTH_COOKIE_NAME=st_session

# Set to "true" when serving the API over HTTPS so the session cookie is marked
# Secure. Keep "false" for local development over http.
COOKIE_SECURE=false

# --- Email notifications (Phase 8) -----------------------------------------
# Emails are sent when a price alert transitions from active to triggered.
# All credentials below are read by the server process only and are never
# exposed to the browser or logged.

# Email provider. "resend" (REST API, https://resend.com) or "none" to disable
# sending entirely. When sending is unconfigured, triggers are still recorded
# in notification history with a clear "not configured" failure.
EMAIL_PROVIDER=resend

# Resend API key (https://resend.com → API Keys). Free tier: 100 emails/day,
# 3,000/month, 10 requests/second, 1 webhook endpoint.
RESEND_API_KEY=your_resend_api_key_here

# From-address. During development Resend allows sending only to your own
# account address from the shared onboarding sender below; production requires
# a verified domain (Resend → Domains → verify DKIM/SPF/DMARC) and a matching
# from-address, e.g. "Stock Tracker <alerts@yourdomain.com>".
EMAIL_FROM=Stock Tracker <onboarding@resend.dev>

# Optional: Resend webhook signing secret (whsec_...) from Resend → Webhooks.
# When set, POST /api/notifications/webhooks/resend is accepted and verified
# (svix signature), and accepted notifications can progress to "delivered".
# Without it, notifications stop at "accepted" — provider acceptance, not a
# delivery guarantee.
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here

# Timeout for a single email send attempt, in milliseconds.
EMAIL_TIMEOUT_MS=8000

# Public base URL of the app; links inside notification emails point here
# (e.g. https://yourdomain.com/stocks/AAPL).
APP_BASE_URL=http://localhost:5173
