# Server-side market data proxy configuration.
# Copy this file to server/.env and fill in your own values: `cp server/.env.example server/.env`
# server/.env is git-ignored and must never be committed.

# Twelve Data API key. Create a free key at https://twelvedata.com/pricing
# The key is only ever read by this server process and is never exposed to the browser.
STOCK_API_KEY=your_twelvedata_api_key_here

# Market data provider. Only "twelvedata" is currently supported.
STOCK_DATA_PROVIDER=twelvedata

# Port the proxy listens on. The Vite dev server proxies /api here.
PORT=3001

# Free-tier guard rails (Twelve Data Basic: 8 requests/minute, 800 credits/day).
PROVIDER_CREDITS_PER_MINUTE=8
PROVIDER_CREDITS_PER_DAY=800

# Upstream request timeout in milliseconds.
REQUEST_TIMEOUT_MS=8000

# Origin allowed to call this proxy. In dev, the Vite server proxies requests so
# it is same-origin; keep the default unless you call the API from another origin.
CORS_ORIGIN=http://localhost:5173

# Cache TTLs, in seconds, per data type.
CACHE_TTL_QUOTE_SECONDS=60
CACHE_TTL_HISTORY_SECONDS=300
CACHE_TTL_SEARCH_SECONDS=300
CACHE_TTL_PROFILE_SECONDS=86400
CACHE_TTL_FINANCIALS_SECONDS=86400

# SQLite database file for users, sessions and watchlists. The parent directory
# is created automatically. This file is git-ignored and must not be committed.
DATABASE_PATH=./data/stock-tracker.sqlite

# Session lifetime in seconds (default 7 days) and the session cookie name.
SESSION_TTL_SECONDS=604800
AUTH_COOKIE_NAME=st_session

# Set to "true" when serving the API over HTTPS so the session cookie is marked
# Secure. Keep "false" for local development over http.
COOKIE_SECURE=false
