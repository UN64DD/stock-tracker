# Copy this file to .env and fill in real values.
# Never commit .env or any file containing real credentials or API keys.

# Base URL for the market data API server. Leave empty in development so the
# Vite dev server proxies same-origin /api requests to the local API server.
# The stock provider API key is NOT set here: it belongs in server/.env only,
# so it is never bundled into the browser build.
VITE_API_BASE_URL=
